DATABASE_URL="file:./dev.db"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL_TEXT="gpt-4.1-mini"
AI_MODEL_VISION="gpt-4.1-mini"
AI_MODEL_VIDEO="gpt-4.1-mini"
AI_SUPPORTS_STRUCTURED_OUTPUTS="false"
AI_REQUEST_TIMEOUT_MS="45000"
AI_VIDEO_INPUT_MODE="hybrid"
AI_DIRECT_VIDEO_MAX_MB="20"
AI_DIRECT_VIDEO_FPS="1"
AI_VIDEO_FRAME_COUNT="12"
ASR_PROVIDER="manual"

# Optional video generation API for segmented AIGC B-roll.
# Leave these empty to keep Remotion as the deterministic render path.
VIDEO_API_BASE_URL=""
VIDEO_API_ENDPOINT="/v1/videos"
VIDEO_API_QUERY_ENDPOINT=""
VIDEO_API_KEY=""
VIDEO_API_MODEL="veo3.1-fast"
VIDEO_API_DURATION_SECONDS="5"
VIDEO_API_SEGMENT_SECONDS="5"
